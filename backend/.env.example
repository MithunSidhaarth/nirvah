# Copy this file to .env before running the server.
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# Postgres connection string.
# Local dev (see docker-compose.yml in the repo root):
#   DATABASE_URL=postgresql://nirvah:nirvah@localhost:5432/nirvah
# Render/Neon/Supabase: paste the connection string they give you (the
# db/index.js and db/migrate.js modules auto-enable SSL for anything that
# isn't localhost).
DATABASE_URL=postgresql://nirvah:nirvah@localhost:5432/nirvah

# Used to build the links inside verification/reset emails
# (e.g. FRONTEND_URL/verify-email?token=...). Also always allowed as a CORS
# origin, so this alone is enough for a single-frontend deployment.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of extra origins allowed to call this API (besides
# FRONTEND_URL above). Only needed if you serve the frontend from more than
# one domain, e.g. a Netlify preview URL plus your production domain.
# ALLOWED_ORIGINS=https://staging.nirvah.app,https://nirvah.app

# Set to "false" only if you are NOT running behind a reverse proxy (Render,
# Railway, Vercel, Netlify, Cloudflare, nginx all count as one). Leaving
# this on when there is no proxy lets a client spoof its IP via
# X-Forwarded-For and dodge rate limiting; leaving it off when there IS a
# proxy makes every request look like it comes from the proxy's IP.
# TRUST_PROXY=false

# Section 4 fills these in for real email delivery via Resend. Until then,
# verification/reset emails are just printed to the backend console.
# RESEND_API_KEY=
# EMAIL_FROM=

# Comma-separated list of user emails allowed to review NGO verification
# and documents (POST /api/ngos/:id/verify, PATCH /api/documents/:id, etc).
# There's no admin role in the database yet — this is a stopgap allowlist.
# Leave unset and those endpoints return 503 rather than silently doing
# nothing.
# ADMIN_EMAILS=you@nirvah.app,ops@nirvah.app

# Base URL used to build links to uploaded documents/photos
# (e.g. BACKEND_PUBLIC_URL/uploads/<file>). Defaults to
# http://localhost:PORT, which is fine for local dev only — set this to
# your real backend URL once deployed.
# BACKEND_PUBLIC_URL=https://api.nirvah.app
